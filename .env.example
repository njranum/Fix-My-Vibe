# Fix My Vibe — environment configuration
#
# Copy this file to `.env` and fill in the values for the mode you want to run.
# Nothing here is required for LOCAL MODE — Fix My Vibe runs fully offline with
# zero configuration. These variables only enable the richer "Foundry mode"
# (LLM-powered agents) and the grounded Azure AI Search knowledge base.
#
# .env is gitignored; .env.example is committed. Never commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Foundry mode — Azure AI Foundry agents (optional)
# Set these to run the Scanner/Researcher/Planner/Executor/Verifier as real
# LLM agents. If FOUNDRY_PROJECT_ENDPOINT is unset, the CLI runs in local mode.
# Auth uses DefaultAzureCredential (run `az login`) — no key goes here.
# ─────────────────────────────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
# Deployment name of a reasoning-capable chat model in your Foundry project
# (e.g. o4-mini). This is the name you gave the deployment, not the base model.
FOUNDRY_MODEL_DEPLOYMENT_NAME=o4-mini

# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Search — grounded knowledge base (optional, used in Foundry mode)
# The Researcher agent queries this index for OWASP/CWE/NIST best practices.
# Without it, the Researcher falls back to web search / static content.
# ─────────────────────────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-or-query-key>
AZURE_SEARCH_INDEX=fix-my-vibe-security-kb

# ─────────────────────────────────────────────────────────────────────────────
# Web search fallback (optional)
# Used by the Researcher for current/novel queries the KB doesn't cover.
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Knowledge-base ingestion only (kb/ingest_security_kb.py)
# Not needed to RUN Fix My Vibe — only to (re)build the Azure AI Search index.
# ─────────────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
